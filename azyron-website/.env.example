# --- AZYRON CLIENT website ----------------------------------------------
PORT=3000
HOST=0.0.0.0

# GitHub release source (defaults match the live site)
GH_OWNER=blazemc125
GH_REPO=AzyronClient
GH_TAG=azyronclient-v1.0.0

# Optional: raises GitHub's rate limit from 60 to 5000 requests/hour.
# The site only calls GitHub once per CACHE_TTL_MS no matter how many
# visitors are online, so this is only needed under heavy traffic.
# GITHUB_TOKEN=

# Server-side cache window for the GitHub API payload (ms)
CACHE_TTL_MS=5000
ERROR_CACHE_TTL_MS=2000

# Where the real proxied-download log is written
ANALYTICS_FILE=./data/downloads.log

# Unique/active visitor store (append-only JSON-lines, replayed on boot).
VISITORS_FILE=./data/visitors.log

# Salt for the IP+User-Agent fallback fingerprint. Raw IPs are never stored.
# Set this to any long random string in production.
VISITOR_SALT=

# Origins allowed to POST visitor heartbeats (the GitHub Pages site is a
# different origin from this API, so it must be listed explicitly).
ALLOWED_ORIGINS=https://blazemc125.github.io

# Last-known-good snapshot rendered if GitHub is unreachable at boot
FALLBACK_FILE=./data/fallback-release.json

# Set when running behind a proxy/CDN if you want absolute URLs
# PUBLIC_ORIGIN=https://azyron.example.com
